# ─────────────────────────────────────────────────────────────────
# Variables de entorno de Komparo backend
# Copia este archivo a .env y rellena los valores para desarrollo.
# En Railway, configúralas en Settings → Variables.
# ─────────────────────────────────────────────────────────────────

# Entorno: development | production
# En production, SECRET_KEY es obligatoria y CORS_ORIGINS debería tener tus dominios reales
ENVIRONMENT=development

# Clave para firmar tokens JWT. Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-en-produccion

# Base de datos. En Railway la inyecta el plugin de PostgreSQL.
# En local con SQLite no hace falta definirla.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# URL del frontend (usada en los emails para construir enlaces)
FRONTEND_URL=http://localhost:3000

# ─── SMTP (envío de emails) ──────────────────────────────────────
# Si no se define SMTP_HOST, los emails se loguean en stdout (modo dev).
# Recomendado: Resend (https://resend.com), gratis hasta 3000 emails/mes
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_FROM=Komparo <noreply@tudominio.com>
